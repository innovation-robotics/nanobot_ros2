<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="lidar_blue">
        <color rgba="0.2 0.3 0.8 1.0"/>
    </material>

    <!-- LDS-02RR Physical Dimensions -->
    <xacro:property name="lidar_radius" value="0.038"/> <!-- ~76mm diameter -->
    <xacro:property name="lidar_height" value="0.040"/> <!-- ~40mm puck height -->
    <xacro:property name="lidar_mass"   value="0.200"/> <!-- ~200g -->

    <!-- Joint: Attach LiDAR to the top deck of base_link -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <!-- Mounted 6cm forward on top deck -->
        <origin xyz="0.06 0 ${chassis_height + (lidar_height/2)}" rpy="0 0 0"/>
    </joint>

    <!-- Link: Frame ID used by ROS 2 /scan message -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
            <material name="lidar_blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}" length="${lidar_height}" radius="${lidar_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>