<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="camera_blue">
        <color rgba="0.2 0.3 0.8 1.0"/>
    </material>

    <!-- LDS-02RR Physical Dimensions -->
    <xacro:property name="camera_width" value="0.04"/> <!-- ~76mm diameter -->
    <xacro:property name="camera_length" value="0.04"/> <!-- ~76mm diameter -->
    <xacro:property name="camera_height" value="0.07"/> <!-- ~40mm puck height -->
    <xacro:property name="camera_mass"   value="0.200"/> <!-- ~200g -->
    <xacro:property name="camera_elevation"   value="0.0725"/> <!-- ~200g -->

    <!-- Joint: Attach camera to the top deck of base_link -->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_optical_frame"/>
        <!-- Mounted 6cm forward on top deck -->
        <origin xyz="0.013 0 ${camera_elevation}" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <!-- Link: Frame ID used by ROS 2 /scan message -->
    <link name="camera_optical_frame">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <material name="camera_blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${camera_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

</robot>