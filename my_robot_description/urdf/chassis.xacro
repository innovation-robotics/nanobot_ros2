<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =================================================================== -->
    <!-- MATERIALS & COLORS FOR RVIZ -->
    <!-- =================================================================== -->
    <material name="wood_mdf">
        <color rgba="0.75 0.55 0.35 1.0"/>
    </material>
    <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
    <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
    </material>

    <!-- =================================================================== -->
    <!-- PROPERTY DEFINITIONS (Tweak these to match physical dimensions) -->
    <!-- =================================================================== -->
    <xacro:property name="chassis_length" value="0.250"/> <!-- 25 cm -->
    <xacro:property name="chassis_width"  value="0.20"/> <!-- 18 cm -->
    <xacro:property name="chassis_height" value="0.1075"/> <!-- 6 cm 0.060--> 
    <xacro:property name="chassis_mass"   value="0.800"/> <!-- 800 g -->

    <xacro:property name="wheel_radius"  value="0.033"/> <!-- 66 mm diameter -->
    <xacro:property name="wheel_thickness" value="0.026"/> <!-- 26 mm width -->
    <xacro:property name="wheel_mass"      value="0.050"/> <!-- 50 g -->
    <xacro:property name="wheel_offset_y"  value="0.1165"/> <!-- Track width center-to-wheel -->
    <xacro:property name="wheel_offset_x"  value="0.0"/> <!-- Axle position along length -->

    <xacro:property name="caster_radius"  value="0.015"/> <!-- 30 mm caster ball -->
    <xacro:property name="caster_mass"    value="0.030"/>
    <xacro:property name="caster_offset_x" value="-0.185"/> <!-- Front/rear caster position -->

    <!-- =================================================================== -->
    <!-- 1. BASE FOOTPRINT (Ground plane z=0) -->
    <!-- =================================================================== -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- =================================================================== -->
    <!-- 2. BASE LINK (Main MDF Chassis) -->
    <!-- =================================================================== -->
    <link name="base_link">
        <visual>
            <origin xyz="-0.105 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="wood_mdf"/>
        </visual>
        <collision>
            <origin xyz="-0.105 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="-0.105 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- =================================================================== -->
    <!-- 3. LEFT WHEEL -->
    <!-- =================================================================== -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${wheel_offset_x} ${wheel_offset_y} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- =================================================================== -->
    <!-- 4. RIGHT WHEEL -->
    <!-- =================================================================== -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${wheel_offset_x} -${wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- =================================================================== -->
    <!-- 5. CASTER WHEEL -->
    <!-- =================================================================== -->
    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${caster_offset_x} 0 -${wheel_radius - caster_radius}" rpy="0 0 0"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

</robot>