<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_microbot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mobile_microbot urdf file -->
    <xacro:include filename="$(find my_robot_description)/urdf/mobile_microbot.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="mobile_microbot.ros2_control.xacro" />


    <xacro:mobile_microbot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
